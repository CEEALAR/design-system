{
  "$schema": "https://schemas.tokens.studio/v1",
  "_meta": {
    "name": "CEEALAR Design System",
    "version": "0.3.0",
    "source": "Aligned with CEEALAR Pulse v1 web implementation (May 2026). Teal/gold palette migrated from the Canva-extracted v0.2 values to the deeper, less-saturated set used in production. Canva sources may now drift; web is canonical for digital surfaces.",
    "date": "2026-05-17"
  },
  "color": {
    "teal": {
      "deep":  { "value": "#0B5953", "type": "color", "description": "Deepest — hover for primary actions, gradient companion" },
      "900":   { "value": "#014652", "type": "color", "description": "Reserved — legacy dark teal" },
      "700":   { "value": "#0F766E", "type": "color", "description": "PRIMARY — fills, buttons, brand surfaces" },
      "soft":  { "value": "#14958B", "type": "color", "description": "Lighter primary, gradient companion" },
      "500":   { "value": "#2BA0B0", "type": "color", "description": "Accents, interactive states" },
      "300":   { "value": "#63C5CE", "type": "color", "description": "Subtitle on teal, supporting text" },
      "100":   { "value": "#D3EBED", "type": "color", "description": "Background tint" }
    },
    "gold": {
      "deep":  { "value": "#B8870E", "type": "color", "description": "Gradient companion — deepest gold" },
      "700":   { "value": "#B08A3E", "type": "color", "description": "Hover for gold actions (text contexts)" },
      "500":   { "value": "#D4A017", "type": "color", "description": "ACCENT — italic serif, borders, dividers" },
      "soft":  { "value": "#E8B73E", "type": "color", "description": "Softer accent, gradient companion" },
      "300":   { "value": "#E5C896", "type": "color", "description": "Subtle backgrounds" }
    },
    "cream": {
      "50":   { "value": "#FAF7F0", "type": "color", "description": "Page background" },
      "100":  { "value": "#F5F0EA", "type": "color", "description": "Card surfaces" },
      "200":  { "value": "#EBE3D6", "type": "color", "description": "Dividers" },
      "deep": { "value": "#F4EFE3", "type": "color", "description": "Subtle warm tint, gradient mesh base" }
    },
    "ink": {
      "900": { "value": "#1A1A1A", "type": "color", "description": "Body text on cream" },
      "700": { "value": "#2D2D2D", "type": "color", "description": "Secondary text" },
      "500": { "value": "#6E6E6E", "type": "color", "description": "Captions, muted" }
    },
    "white": { "value": "#FFFFFF", "type": "color" },

    "semantic": {
      "text": {
        "primary":   { "value": "{color.ink.900}",   "type": "color" },
        "secondary": { "value": "{color.ink.700}",   "type": "color" },
        "muted":     { "value": "{color.ink.500}",   "type": "color" },
        "inverse":   { "value": "{color.cream.100}", "type": "color" },
        "accent":    { "value": "{color.gold.500}",  "type": "color" }
      },
      "surface": {
        "canvas":  { "value": "{color.cream.50}",  "type": "color" },
        "card":    { "value": "{color.cream.100}", "type": "color" },
        "feature": { "value": "{color.teal.700}",  "type": "color" }
      },
      "border": {
        "default":  { "value": "{color.cream.200}", "type": "color" },
        "accent":   { "value": "{color.gold.500}",  "type": "color" },
        "emphasis": { "value": "{color.teal.700}",  "type": "color" }
      }
    }
  },

  "typography": {
    "fontFamily": {
      "display": { "value": "DM Sans, 'Helvetica Neue', Arial, sans-serif", "type": "fontFamily" },
      "serif":   { "value": "Playfair Display, Garamond, 'Times New Roman', serif", "type": "fontFamily" },
      "body":    { "value": "DM Sans, 'Helvetica Neue', Arial, sans-serif", "type": "fontFamily" }
    },
    "fontWeight": {
      "regular":  { "value": 400, "type": "fontWeight" },
      "medium":   { "value": 500, "type": "fontWeight" },
      "semibold": { "value": 600, "type": "fontWeight" },
      "bold":     { "value": 700, "type": "fontWeight" }
    },
    "scale": {
      "displayXL": { "value": { "fontFamily": "{typography.fontFamily.display}", "fontWeight": 700, "fontSize": "56px", "lineHeight": "1.05", "letterSpacing": "-1.5px" }, "type": "typography" },
      "displayLG": { "value": { "fontFamily": "{typography.fontFamily.display}", "fontWeight": 600, "fontSize": "40px", "lineHeight": "1.1", "letterSpacing": "-0.8px" }, "type": "typography" },
      "displayMD": { "value": { "fontFamily": "{typography.fontFamily.display}", "fontWeight": 600, "fontSize": "28px", "lineHeight": "1.2", "letterSpacing": "-0.3px" }, "type": "typography" },
      "serifXL":   { "value": { "fontFamily": "{typography.fontFamily.serif}",   "fontWeight": 500, "fontStyle": "italic", "fontSize": "48px", "lineHeight": "1.1"  }, "type": "typography" },
      "serifLG":   { "value": { "fontFamily": "{typography.fontFamily.serif}",   "fontWeight": 500, "fontStyle": "italic", "fontSize": "32px", "lineHeight": "1.2"  }, "type": "typography" },
      "serifMD":   { "value": { "fontFamily": "{typography.fontFamily.serif}",   "fontWeight": 500, "fontStyle": "italic", "fontSize": "22px", "lineHeight": "1.4"  }, "type": "typography" },
      "bodyLG":    { "value": { "fontFamily": "{typography.fontFamily.body}",    "fontWeight": 400, "fontSize": "18px", "lineHeight": "1.6" }, "type": "typography" },
      "bodyMD":    { "value": { "fontFamily": "{typography.fontFamily.body}",    "fontWeight": 400, "fontSize": "16px", "lineHeight": "1.6" }, "type": "typography" },
      "bodySM":    { "value": { "fontFamily": "{typography.fontFamily.body}",    "fontWeight": 400, "fontSize": "14px", "lineHeight": "1.5" }, "type": "typography" },
      "eyebrow":   { "value": { "fontFamily": "{typography.fontFamily.display}", "fontWeight": 600, "fontSize": "12px", "lineHeight": "1.0", "letterSpacing": "3px", "textTransform": "uppercase" }, "type": "typography" }
    }
  },

  "spacing": {
    "0": { "value": "4px",  "type": "spacing" },
    "1": { "value": "8px",  "type": "spacing" },
    "2": { "value": "16px", "type": "spacing" },
    "3": { "value": "24px", "type": "spacing" },
    "4": { "value": "32px", "type": "spacing" },
    "5": { "value": "48px", "type": "spacing" },
    "6": { "value": "64px", "type": "spacing" },
    "7": { "value": "96px", "type": "spacing" }
  },

  "borderRadius": {
    "sm":   { "value": "6px",   "type": "borderRadius" },
    "md":   { "value": "12px",  "type": "borderRadius" },
    "lg":   { "value": "20px",  "type": "borderRadius" },
    "xl":   { "value": "32px",  "type": "borderRadius", "description": "Hero header / large feature surfaces" },
    "pill": { "value": "999px", "type": "borderRadius" }
  },

  "shadow": {
    "xs":       { "value": "0 1px 2px 0 rgba(15,23,42,0.04)",                                            "type": "boxShadow", "description": "Hairline / inset elevation" },
    "sm":       { "value": "0 1px 3px 0 rgba(15,23,42,0.05), 0 1px 2px -1px rgba(15,23,42,0.04)",        "type": "boxShadow", "description": "Card resting state" },
    "md":       { "value": "0 4px 12px -2px rgba(15,23,42,0.06), 0 2px 4px -2px rgba(15,23,42,0.04)",    "type": "boxShadow", "description": "Card hover / popover" },
    "lg":       { "value": "0 10px 30px -8px rgba(15,23,42,0.08), 0 4px 6px -4px rgba(15,23,42,0.04)",   "type": "boxShadow", "description": "Modal / dialog" },
    "hero":     { "value": "0 24px 60px -20px rgba(15,118,110,0.18), 0 8px 16px -8px rgba(15,23,42,0.08)", "type": "boxShadow", "description": "Hero header / feature surfaces — teal-tinted" },
    "glowTeal": { "value": "0 0 0 3px rgba(15,118,110,0.12)",                                            "type": "boxShadow", "description": "Focus ring / active state — teal" }
  },

  "gradient": {
    "teal":  { "value": "linear-gradient(135deg, #14958B 0%, #0B5953 100%)", "type": "color", "description": "Primary brand gradient — buttons, hero surfaces" },
    "gold":  { "value": "linear-gradient(135deg, #E8B73E 0%, #B8870E 100%)", "type": "color", "description": "Accent gradient — sparingly, for emphasis" },
    "warm":  { "value": "linear-gradient(180deg, #FAF7F0 0%, #F4EFE3 100%)", "type": "color", "description": "Subtle vertical warm tint — section dividers" },
    "mesh":  { "value": "radial-gradient(at 8% 18%, rgba(15,118,110,0.10) 0%, transparent 38%), radial-gradient(at 92% 14%, rgba(212,160,23,0.10) 0%, transparent 42%)", "type": "color", "description": "Page-level radial mesh — under cream surface" }
  },

  "motion": {
    "duration": {
      "fast":   { "value": "120ms", "type": "duration", "description": "Hover / press feedback" },
      "medium": { "value": "200ms", "type": "duration", "description": "Standard transitions (default)" },
      "slow":   { "value": "320ms", "type": "duration", "description": "Sheet / dialog enter/leave" }
    },
    "easing": {
      "outQuart": { "value": "cubic-bezier(0.25, 1, 0.5, 1)", "type": "cubicBezier", "description": "Default ease — quick start, gentle settle" },
      "outExpo":  { "value": "cubic-bezier(0.16, 1, 0.3, 1)", "type": "cubicBezier", "description": "Dramatic enter — for hero/modal reveals" }
    }
  }
}
